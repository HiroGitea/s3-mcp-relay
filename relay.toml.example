# S3 MCP Relay configuration — RainYun ROS example.
#
# Copy to relay.toml next to the binary, or point RELAY_CONFIG at it.
# Every setting here can also be given as an environment variable, and the
# environment always wins. Unknown keys are a startup error, not a silent
# no-op, so a typo in a security setting fails loudly.
#
# This file may contain credentials and private keys. Keep the deployed copy
# owner-only (0600) and never commit real values. Environment variables and
# systemd credentials remain supported as stricter deployment options.

[s3]
# RainYun console: 对象存储 → 实例 → 访问凭证信息.
# The console shows the endpoint with the bucket name appended; drop that part.
# Region codes match the endpoint host, e.g. cn-sy1 / cn-hk1.
endpoint = "https://cn-sy1.rains3.com"
region   = "cn-sy1"
bucket   = "legacy-control-relay"

# Key namespace inside the bucket. Use a dedicated bucket or prefix, with
# versioning and Object Lock OFF, so consumed objects really disappear.
prefix = "relay-prod/"

# ROS accepts path-style addressing, which is also what most self-hosted S3
# servers require. Leave this on unless RainYun tells you otherwise.
force_path_style = true

# Never true outside a trusted local test network.
allow_insecure_http = false

[relay]
# Labels the shared key so both ends can detect a mismatch. Bump it when you
# rotate RELAY_SHARED_KEY.
key_id = "primary"

# ---------------------------------------------------------------------------
# Controller side (the MCP server Claude launches). Ignored by the agent.
# ---------------------------------------------------------------------------
[controller]
# Every machine Claude may talk to. An agent that is not listed here stays
# invisible to list_agents even when its heartbeat is healthy.
allowed_agents = ["legacy-01", "legacy-02"]

# How long a queued command stays valid before the agent refuses to start it.
queue_ttl_secs = 120

# Ceiling for a single command, and for the whole wait including queueing.
max_exec_secs = 300
max_wait_secs = 430

# Transfers get their own ceiling: a few hundred megabytes legitimately takes
# longer than any command should. The agent max_timeout_secs must be at least
# as large, or it will reject the transfer command.
max_transfer_secs = 1800

# Starting interval for response polling; the controller doubles it up to 2s.
poll_ms = 200

# Generated by `s3-relay-mcp init`. The controller private key stays in this
# owner-only TOML. SQLite stores enrolled agent public keys, never private or
# derived session keys.
private_key = "replace-with-controller-x25519-private-key"
public_key = "replace-with-controller-x25519-public-key"
database = "/home/operator/.config/relay/controller.db"
log_dir = "/home/operator/.local/state/relay/logs"

# ---------------------------------------------------------------------------
# Agent side (the isolated server). Ignored by the controller.
# ---------------------------------------------------------------------------
[agent]
# Must match one of controller.allowed_agents, and be unique per machine.
id = "legacy-01"

# File operations are confined to these roots, after symlink resolution.
# A TOML array avoids the ';' vs ':' platform split the env var needs.
allowed_roots = [
    "/srv/legacy-app",
    "/var/log/legacy-app",
]

# exec may only run these exact absolute paths. No shell is involved and
# arguments are never expanded. Ignored when allow_any_program is true.
allowed_programs = [
    "/usr/bin/systemctl",
    "/usr/bin/journalctl",
]

# Full-capability mode: the agent gets the same reach a local shell would, and
# the trust boundary moves entirely to the controller side, where Claude Code
# gates every call.
#
#   allow_any_path    file operations are not confined to allowed_roots
#   allow_any_program exec can run anything, including /bin/bash -c "..."
#
# With allow_any_program on, this is remote code execution by design. That is a
# reasonable choice when the bucket, both machines, and the Claude session are
# all yours; it is not one to make on a host you share with anyone else.
#
# Leave both off and use the two allowlists above for a restricted deployment.
allow_any_path    = true
allow_any_program = true

# Only these non-secret variables are inherited by child processes; everything
# else, including the S3 and relay credentials, is stripped.
child_env_allowlist = ["LANG", "LC_ALL", "TZ"]

# Per-command ceilings. max_file_bytes and max_output_bytes are capped at
# 1048576 by the code regardless of what is written here; they bound what fits
# inside a single command, not what push_file/pull_file can move.
#
# Raise max_timeout_secs if you push large files: a transfer is one command,
# and it is bounded by this as well as by controller.max_transfer_secs.
max_timeout_secs = 1800
max_file_bytes   = 1048576
max_output_bytes = 1048576

# Ceiling for one push_file/pull_file transfer. Streamed in 8 MiB chunks, so
# peak memory stays around 16 MB no matter how large this is.
max_blob_bytes = 1073741824

# Poll interval right after work arrives, and the floor for backoff.
poll_ms = 200
# Ceiling the interval backs off to while the mailbox stays empty.
poll_max_ms = 5000
# Force a full LIST at least this often, in case a doorbell update was lost.
full_scan_secs = 60
# false = LIST on every tick instead of checking the doorbell first.
doorbell = true

# ttl must be at least twice the interval, or the agent refuses to start.
heartbeat_secs     = 15
heartbeat_ttl_secs = 45

# Generated by `relay-agent init`. The shared transport key is derived in
# memory from these values and is never persisted.
private_key = "replace-with-agent-x25519-private-key"
public_key = "replace-with-agent-x25519-public-key"
controller_public_key = "replace-with-controller-public-key"

# Install binaries the controller publishes with publish_update.
#
# Five things are checked before this agent replaces itself: the release targets
# this platform, its own binary does not already match it, the manifest is newer
# than the last one applied, no job is running, and the downloaded binary
# actually starts and answers --version. A failed install rolls back.
#
# The install directory has to be writable by the agent. Under
# ProtectSystem=strict that means a ReadWritePaths entry for it, or every update
# fails on a read-only filesystem. On a restricted host, consider leaving this
# off instead: an agent that can rewrite its own executable can arrange to run
# anything as its service user after a restart.
auto_update = true
# One HEAD per interval while nothing has changed.
update_check_secs = 300

# Local logs are encrypted and uploaded incrementally to the controller. Only
# completed/rotated local files are eligible for cleanup; running jobs remain.
job_dir = "/var/lib/relay-agent/jobs"
job_retention_days = 7
job_max_total_bytes = 1073741824
job_cleanup_interval_secs = 21600
job_ship_chunk_bytes = 131072
