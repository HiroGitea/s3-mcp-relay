{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOwnCommandsAndTransfers",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "REPLACE_PREFIX/cmd/REPLACE_AGENT/*",
            "REPLACE_PREFIX/blob/REPLACE_AGENT/*"
          ]
        }
      }
    },
    {
      "Sid": "TransferChunks",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/REPLACE_PREFIX/blob/REPLACE_AGENT/*"
    },
    {
      "Sid": "ConsumeOwnCommands",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/REPLACE_PREFIX/cmd/REPLACE_AGENT/*"
    },
    {
      "Sid": "CheckOwnDoorbell",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/REPLACE_PREFIX/doorbell/REPLACE_AGENT.json"
    },
    {
      "Sid": "PublishOwnResponsesAndHeartbeat",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::REPLACE_BUCKET/REPLACE_PREFIX/resp/REPLACE_AGENT/*",
        "arn:aws:s3:::REPLACE_BUCKET/REPLACE_PREFIX/agents/REPLACE_AGENT.json"
      ]
    },
    {
      "Sid": "RemoveOwnHeartbeat",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/REPLACE_PREFIX/agents/REPLACE_AGENT.json"
    },
    {
      "Sid": "ReadOwnUpdateManifest",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/REPLACE_PREFIX/updates/manifest/REPLACE_AGENT.json"
    },
    {
      "Sid": "DownloadPublishedReleases",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/REPLACE_PREFIX/updates/blob/*"
    }
  ]
}

