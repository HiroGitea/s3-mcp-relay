# Shared S3 settings (use different access keys/policies on each side)
S3_ENDPOINT=https://s3.example.internal
S3_REGION=us-east-1
S3_BUCKET=legacy-control-relay
S3_PREFIX=relay-prod/
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true
# Never enable this outside a trusted local test network.
S3_ALLOW_INSECURE_HTTP=false

# Same 32-byte random key on controller and agent, encoded as standard base64.
RELAY_SHARED_KEY=replace-with-base64-encoded-32-byte-key
RELAY_KEY_ID=primary

# Controller only
CONTROL_ALLOWED_AGENTS=legacy-01
CONTROL_QUEUE_TTL_SECS=120
CONTROL_MAX_EXEC_SECS=300
CONTROL_MAX_WAIT_SECS=430
# Transfers get their own, much larger ceiling than ordinary commands.
CONTROL_MAX_TRANSFER_SECS=1800
# Starting interval for response polling; the controller doubles it up to 2s.
CONTROL_POLL_MS=200
# New installations use these instead of CONTROL_ALLOWED_AGENTS and a shared
# key. Enrolled agent public keys live in SQLite.
CONTROL_PRIVATE_KEY=replace-with-controller-x25519-private-key
CONTROL_PUBLIC_KEY=replace-with-controller-x25519-public-key
CONTROL_DATABASE=/home/operator/.config/relay/controller.db
CONTROL_LOG_DIR=/home/operator/.local/state/relay/logs
# Delete a published release once every agent that still matters is running it.
CONTROL_AUTO_CLEANUP=true
CONTROL_CLEANUP_CHECK_SECS=300
# An agent silent this long is treated as decommissioned: it stops holding a
# finished rollout open, and it comes back to no manifest.
CONTROL_UPDATE_SEEN_DAYS=3
# Watch a GitHub repository and publish each new release automatically. Unset
# means off, which is the right default: it downloads binaries from the internet
# and hands them to every machine in the fleet.
# CONTROL_AUTO_PUBLISH_REPO=HiroGitea/s3-mcp-relay
# CONTROL_AUTO_PUBLISH_CHECK_SECS=3600

# Agent only
RELAY_AGENT_ID=legacy-01
# Platform-separated paths: ';' on Windows and ':' on Unix.
AGENT_ALLOWED_ROOTS=/srv/legacy-app:/var/log/legacy-app
# Exact program strings accepted from MCP. Do not allow sh/bash/cmd/powershell.
AGENT_ALLOWED_PROGRAMS=/usr/bin/systemctl,/usr/bin/journalctl,/usr/bin/git
# Only these non-secret parent variables may be inherited by child processes.
AGENT_CHILD_ENV_ALLOWLIST=LANG,LC_ALL,TZ,SYSTEMROOT,WINDIR,TEMP,TMP
# Raise this if you push large files: a transfer is one command and is bounded
# by it as well as by CONTROL_MAX_TRANSFER_SECS.
AGENT_MAX_TIMEOUT_SECS=1800
AGENT_MAX_FILE_BYTES=1048576
AGENT_MAX_OUTPUT_BYTES=1048576
# Ceiling for one push_file/pull_file transfer (streamed in 8 MiB chunks).
AGENT_MAX_BLOB_BYTES=1073741824
# Full-capability mode: file ops ignore AGENT_ALLOWED_ROOTS, and exec can run
# anything including /bin/bash -c. This is remote code execution by design; the
# controller side becomes the only gate. Leave both false for a restricted host.
AGENT_ALLOW_ANY_PATH=true
AGENT_ALLOW_ANY_PROGRAM=true
# Poll interval right after work arrives, and the floor for backoff.
AGENT_POLL_MS=200
# Ceiling the interval backs off to while the mailbox stays empty.
AGENT_POLL_MAX_MS=5000
# Force a full LIST at least this often, in case a doorbell update was lost.
AGENT_FULL_SCAN_SECS=60
# Set to false to LIST on every tick instead of checking the doorbell first.
AGENT_DOORBELL=true
AGENT_HEARTBEAT_SECS=15
AGENT_HEARTBEAT_TTL_SECS=45
AGENT_PRIVATE_KEY=replace-with-agent-x25519-private-key
AGENT_PUBLIC_KEY=replace-with-agent-x25519-public-key
AGENT_CONTROLLER_PUBLIC_KEY=replace-with-controller-public-key
# Install binaries the controller publishes with publish_update. The agent only
# acts on a release built for its own platform, waits for running jobs to finish
# before restarting, and puts the old binary back if the new one will not start.
# Needs a writable install directory: under ProtectSystem=strict the unit must
# list it in ReadWritePaths or every update fails on a read-only filesystem.
AGENT_AUTO_UPDATE=true
# How often to look for a published release. One HEAD per interval while nothing
# has changed.
AGENT_UPDATE_CHECK_SECS=300

AGENT_JOB_DIR=/var/lib/relay-agent/jobs
AGENT_JOB_RETENTION_DAYS=7
AGENT_JOB_MAX_TOTAL_BYTES=1073741824
AGENT_JOB_CLEANUP_INTERVAL_SECS=21600
AGENT_JOB_SHIP_CHUNK_BYTES=131072
